---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import EventStep from '../components/EventStep.astro';
import Gifts from '../components/Gifts.astro';
import Footer from '../components/Footer.astro';

import ritaCarlo from '../img/rita-carlo.jpg';
import ritaCarlo6 from '../img/rita-e-carlo-2.jpg';
import ritaCarlo6Orig from '../img/rita-carlo-6.jpg';
import ritaECarlo1 from '../img/rita-e-carlo-1.jpg';
import ritaECarlo from '../img/rita-e-carlo.jpeg';
import chiesaEremitani from '../img/chiesa-eremitani.jpg';
import centroParrocchialeAve from '../img/centro-parrocchiale-AVE.jpg';

import fogliaAccentBr from '../assets/decor/foglia-accent-br.svg';
import fogliaAccentTl from '../assets/decor/foglia-accent-tl.svg';
import foglieAccentTr from '../assets/decor/foglie-accent-tr.svg';
import ficoAccentBl from '../assets/decor/fico-accent-bl.svg';
---

<Layout>
	<Hero />

	<PhotoStrip
		background="cream"
		photos={[
			{ src: ritaECarlo1, alt: 'Rita e Carlo' },
			{ src: ritaCarlo6, alt: 'Rita e Carlo' },
		]}
	/>

	<EventStep
		id="programma"
		variant="messa"
		step="01"
		eyebrow="PRIMA TAPPA"
		title="La Santa Messa"
		timeBadge="ORE 11:00"
		venueName="Chiesa degli Eremitani"
		address="Piazza Eremitani 9, 35121 Padova (PD)"
		mapsHref="https://maps.app.goo.gl/KbPq2gss1LsdtyXQ8"
		photo={chiesaEremitani}
		photoAlt="Chiesa degli Eremitani"
		decorImages={[
			{ src: fogliaAccentTl, position: 'tl' },
			{ src: fogliaAccentBr, position: 'br' },
		]}
	/>

	<PhotoStrip
		background="purple"
		photos={[
			{ src: ritaECarlo, alt: 'Rita e Carlo' },
			{ src: ritaCarlo, alt: 'Rita e Carlo' },
		]}
	/>

	<EventStep
		variant="festa"
		step="02"
		eyebrow="SECONDA TAPPA"
		title="La Festa"
		timeBadge="A SEGUIRE, DALLE 12:30"
		venueName={`Centro Parrocchiale "AVE"`}
		address="Via Papa Giovanni XXIII 3, Casalserugo (PD)"
		mapsHref="https://maps.app.goo.gl/L7t3KLV4ZhBLET649"
		photo={centroParrocchialeAve}
		photoAlt={`Centro Parrocchiale "AVE"`}
		photoPosition="right"
		decorImages={[
			{ src: foglieAccentTr, position: 'tr' },
			{ src: ficoAccentBl, position: 'bl' },
		]}
	/>

	<PhotoStrip background="cream" photos={[{ src: ritaCarlo6Orig, alt: 'Rita e Carlo' }]} />

	<Gifts />

	<Footer />
</Layout>
