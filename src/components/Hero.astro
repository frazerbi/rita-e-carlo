---
import ficoTl from '../assets/decor/fico-tl.svg';
import foglieBr from '../assets/decor/foglie-br.svg';

interface Props {
	rsvpHref?: string;
}

const { rsvpHref } = Astro.props;
---

<section class="hero">
	<img class="decor decor-tl" src={ficoTl.src} alt="" aria-hidden="true" />
	<img class="decor decor-br" src={foglieBr.src} alt="" aria-hidden="true" />

	<blockquote class="quote">
		<p>
			"Il regno dei cieli fa risultare la bellezza la certezza, la permanenza e la libertà di quel
			rapporto visto nel suo scopo ultimo, che è la luce di Dio, cioè Cristo."
		</p>
		<cite>Don Luigi Giussani</cite>
	</blockquote>

	<span class="badge">12 SETTEMBRE 2026</span>
	<h1>Rita &amp; Carlo</h1>
	<p class="subtitle">
		Annunciano con gioia il loro matrimonio</p>

	{rsvpHref && (
		<a class="rsvp-cta" href={rsvpHref} target="_blank" rel="noopener noreferrer">
			Compila il form RSVP →
		</a>
	)}
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(16px, 2.5vw, 28px);
		background: var(--color-purple);
		overflow: clip;
		padding: clamp(120px, 16vw, 180px) clamp(24px, 6vw, 80px) clamp(90px, 12vw, 140px);
		text-align: center;
	}

	.quote {
		margin: 0 0 clamp(8px, 1.5vw, 16px);
		max-width: 52ch;
	}

	.quote p {
		margin: 0;
		font-family: var(--font-body);
		font-style: italic;
		font-weight: 400;
		color: var(--color-cream);
		opacity: 0.9;
		font-size: clamp(15px, 1.6vw, 18px);
		line-height: 1.5;
	}

	.quote cite {
		display: block;
		margin-top: 10px;
		font-family: var(--font-body);
		font-style: normal;
		font-weight: 600;
		letter-spacing: 1px;
		font-size: 13px;
		color: var(--color-cream);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: clamp(14px, 1.4vw, 18px);
		letter-spacing: 2.5px;
		text-transform: uppercase;
		color: var(--color-cream);
	}

	.badge::before,
	.badge::after {
		content: '';
		width: 22px;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		color: var(--color-cream);
		font-size: clamp(48px, 8vw, 96px);
		letter-spacing: 1px;
		max-width: 20ch;
	}

	.subtitle {
		margin: 0;
		font-family: var(--font-body);
		color: var(--color-cream);
		font-size: clamp(17px, 2vw, 22px);
		max-width: 40ch;
	}

	.rsvp-cta {
		margin-top: 8px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-cream);
		text-decoration: none;
		background: var(--color-orange-dark);
		padding: 12px 28px;
		border-radius: 999px;
	}

	.decor {
		position: absolute;
		pointer-events: none;
		opacity: 0.9;
	}

	.decor-tl {
		top: -60px;
		left: -70px;
		width: clamp(140px, 16vw, 220px);
	}

	.decor-br {
		bottom: -10px;
		right: -10px;
		width: clamp(110px, 12vw, 160px);
	}

	@media (max-width: 640px) {
		.decor {
			opacity: 0.6;
		}
		.decor-tl {
			width: 110px;
			top: -40px;
			left: -50px;
		}
		.decor-br {
			width: 90px;
		}
	}
</style>
